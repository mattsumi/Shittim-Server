{
  "name": "shittim-control-center",
  "productName": "Shittim Control Center",
  "version": "2026.8.12",
  "description": "Blue Archive themed control center for the Shittim-Server: configure, launch, and administer the server, accounts, inventory, mail, events and gacha.",
  "main": "main.js",
  "author": "Shittim",
  "license": "MIT",
  "scripts": {
    "test": "node --test test/updater.test.js test/paths.test.js test/console.test.js test/health.test.js test/procs.test.js test/certs.test.js test/setup.test.js test/prereqs.test.js",
    "soak": "electron test/soak.js --no-sandbox",
    "start": "electron .",
    "dev": "electron . --dev",
    "dist": "electron-builder",
    "publish": "electron-builder --publish always"
  },
  "dependencies": {
    "electron-updater": "^6.8.9"
  },
  "devDependencies": {
    "electron": "^33.2.0",
    "electron-builder": "^25.1.8"
  },
  "build": {
    "appId": "com.shittim.controlcenter",
    "productName": "Shittim Control Center",
    "directories": {
      "output": "dist",
      "buildResources": "build"
    },
    "publish": [
      {
        "provider": "github",
        "owner": "Neoexm",
        "repo": "Shittim-Server",
        "releaseType": "release"
      }
    ],
    "files": [
      "main.js",
      "preload.js",
      "paths.js",
      "updater.js",
      "procs.js",
      "certs.js",
      "prereqs.js",
      "src/**/*",
      "Sprite/**/*",
      "package.json"
    ],
    "win": {
      "target": [
        "portable",
        "nsis"
      ],
      "icon": "build/icon.ico"
    },
    "linux": {
      "target": [
        "AppImage",
        "deb"
      ],
      "icon": "build/icon.png",
      "category": "Game",
      "artifactName": "ShittimControlCenter-v${version}-${arch}.${ext}"
    },
    "mac": {
      "target": [
        { "target": "dmg", "arch": ["arm64"] },
        { "target": "zip", "arch": ["arm64"] }
      ],
      "icon": "build/icon.png",
      "category": "public.app-category.games",
      "artifactName": "ShittimControlCenter-v${version}-${arch}.${ext}"
    },
    "portable": {
      "artifactName": "ShittimControlCenter-v${version}-portable.${ext}"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "artifactName": "ShittimControlCenter-v${version}-Setup.${ext}"
    }
  }
}
